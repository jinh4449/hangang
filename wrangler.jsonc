// Cloudflare 배포 설정.
//
// Cloudflare 가 이 저장소를 직접 빌드해서 올릴 때 읽는다. 사이트는 빌드 때
// 전부 HTML 로 만들어지므로(next.config.ts 의 output: "export") 서버 코드는
// 없고, out/ 의 파일을 그대로 내보내기만 한다.
//
// name 은 Cloudflare 대시보드의 Worker 이름과 같아야 한다. 다르면 빌드가
// 「이름이 맞지 않는다」며 멈춘다.
{
  "name": "hangang",
  "compatibility_date": "2026-09-01",
  // hangang.jinh4449.workers.dev 주소를 켠다. 실제 도메인으로 옮기기 전에
  // 여기서 먼저 확인한다
  "workers_dev": true,
  "assets": {
    "directory": "./out",
    // /about 으로 들어오면 about.html 을 준다
    "html_handling": "auto-trailing-slash",
    // 없는 주소는 빈 화면 대신 우리 404.html 을 보여 준다
    "not_found_handling": "404-page"
  }
}
